<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.goriok.token-pusher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/goriok/sources/my-cluster/k8s/environments/local/token-pusher/pusher.py</string>
        <string>--gateway</string>
        <string>https://pushgateway.goriok.com</string>
        <string>--days</string>
        <string>30</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/token-pusher.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/token-pusher.log</string>
</dict>
</plist>
